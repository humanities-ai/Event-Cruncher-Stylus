# Copy this file to `.env` in the repo root and adjust values for your
# deployment. docker-compose automatically reads a `.env` file here and
# substitutes these variables into docker-compose.yml.
#
# Local/dev defaults (matching the previous hardcoded localhost behavior)
# are used whenever a variable is left unset.

# Port the server listens on and is published on.
SERVER_PORT=4000

# Port the client dev server listens on and is published on.
CLIENT_PORT=3000

# URL the browser uses to reach the server's API. Must be reachable from
# wherever the end user's browser runs, so for any deployment beyond a
# single developer machine this should be the server's public URL
# (e.g. https://api.ecs.example.edu).
REACT_APP_API_BASE_URL=http://localhost:4000

# Origin(s) allowed to call the server's API, comma-separated. Must match
# wherever the client above is actually served from
# (e.g. https://ecs.example.edu).
CLIENT_ORIGIN=http://localhost:3000
