# Settings for the ECS production stack on the VM. Copy this file to
# /opt/ecs/.env next to docker-compose.yml, fill in the passwords, and run
#   chmod 600 /opt/ecs/.env
# After editing, apply changes with:  docker compose up -d
# Anything left commented out uses the default shown.

# ---- MySQL -------------------------------------------------------------
# Required. Choose strong, different values.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

#MYSQL_DATABASE=ecsdb
#MYSQL_USER=ecs

# ---- Ports -------------------------------------------------------------
# Ports published on the VM for the server (API) and the client (web app).
#SERVER_PORT=4000
#CLIENT_PORT=3000

# ---- Client and API addressing ------------------------------------------
# URL the browser uses to reach the API. Leave empty to use the same origin
# as the web app, which is what you want when the client's nginx forwards
# /api to the server. Set it (for example https://api.ecs.example.edu) only
# if the API is served from a different host.
#API_BASE_URL=

# Where the client's nginx forwards /api requests inside Docker.
# Default: http://server:<SERVER_PORT>
#API_UPSTREAM=http://server:4000

# Origin(s) allowed to call the API from a different host, comma-separated
# (CORS). Only relevant when API_BASE_URL points at a different host than the
# web app, or when something other than the client's nginx calls the API.
#CLIENT_ORIGIN=http://ls-llc-poiesis:3000

# Largest request body accepted (file uploads) and how long to wait on the API
# (AI features can be slow).
#CLIENT_MAX_BODY_SIZE=100m
#PROXY_READ_TIMEOUT=300s

# ---- Images ------------------------------------------------------------
# Pin a tag here to roll back, for example
#   ECS_SERVER_IMAGE=ghcr.io/humanities-ai/ecs-server:sha-1a2b3c4
#   ECS_CLIENT_IMAGE=ghcr.io/humanities-ai/ecs-client:sha-1a2b3c4
# Note that Watchtower only follows the tag you specify.
#ECS_SERVER_IMAGE=ghcr.io/humanities-ai/ecs-server:latest
#ECS_CLIENT_IMAGE=ghcr.io/humanities-ai/ecs-client:latest

# ---- Watchtower --------------------------------------------------------
# Credentials Watchtower uses to pull the private images. Kept beside this
# stack, not in a person's home directory. Create it with:
#   mkdir -p /opt/ecs/docker && chmod 700 /opt/ecs/docker
#   DOCKER_CONFIG=/opt/ecs/docker docker login ghcr.io -u GITHUB_USERNAME
DOCKER_CONFIG_FILE=/opt/ecs/docker/config.json

# Seconds between checks for new images.
#WATCHTOWER_POLL_INTERVAL=300
#WATCHTOWER_IMAGE=nickfedor/watchtower:1.23.1
