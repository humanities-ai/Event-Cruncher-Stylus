# Rendered by the nginx image at container start: ${VARIABLES} are replaced
# from the container's environment, and nginx's own $variables are left alone.

server {
    listen ${CLIENT_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Runtime configuration is generated at container start and must never be cached.
    location = /env-config.js {
        add_header Cache-Control "no-store";
    }

    # Content-hashed build output can be cached indefinitely.
    location /static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Forward API calls to the server container. The upstream is resolved at
    # request time (not at nginx start-up) so the client keeps working when
    # the server container is recreated with a new address, for example after
    # Watchtower pulls a new image.
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $api_upstream ${API_UPSTREAM};

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_READ_TIMEOUT};
    }

    # Single-page application fallback.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
